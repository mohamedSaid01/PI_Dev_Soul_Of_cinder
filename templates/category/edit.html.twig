{% extends 'baseBackOffice.html.twig' %}

{% block title %}Modifier la Catégorie{% endblock %}

{% block body %}
<main id="main" class="main">
  <div class="pagetitle">
    <h1>Modifier la Catégorie</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
        <li class="breadcrumb-item">Produits</li>
        <li class="breadcrumb-item active">Catégories</li>
      </ol>
    </nav>
  </div>
  <section class="section">
    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Modifier la Catégorie : {{ category.name }}</h5>
            {{ form_start(form) }}
            <div class="mb-3">
              {{ form_label(form.name, 'Nom de la catégorie', {'label_attr': {'class': 'form-label'}}) }}
              {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
              {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
              {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="d-flex gap-2 mt-4">
              <button type="submit" class="btn btn-primary px-4"><i class="fa fa-save me-2"></i>Enregistrer</button>
              <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary px-4"><i class="fa fa-arrow-left me-2"></i>Annuler</a>
            </div>
            {{ form_end(form) }}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .btn-secondary:hover { background-color: #6c757d; border-color: #6c757d; }
  </style>
{% endblock %}