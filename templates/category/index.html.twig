{% extends 'baseBackOffice.html.twig' %}

{% block title %}Gestion des Catégories{% endblock %}

{% block body %}
<main id="main" class="main">
  <div class="pagetitle mb-4">
    <h1 class="page-title"><i class="bi bi-tags"></i> Gestion des Catégories</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
        <li class="breadcrumb-item">Produits</li>
        <li class="breadcrumb-item active">Catégories</li>
      </ol>
    </nav>
  </div>
  <div class="row g-4">
    <div class="col-12">
      <div class="card glass-card p-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="card-title mb-0"><i class="bi bi-list-task"></i> Liste des Catégories</h3>
            <a href="{{ path('app_category_new') }}" class="btn btn-success">
              <i class="bi bi-plus-circle"></i> Ajouter une catégorie
            </a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover table-bordered shadow-sm">
              <thead style="background: #dbeafe; color: #222; font-weight: bold;">
                <tr>
                  <th>Nom</th>
                  <th>Description</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for category in categories %}
                  <tr>
                    <td>{{ category.name }}</td>
                    <td>{{ category.description }}</td>
                    <td class="d-flex gap-1">
                      <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-warning btn-sm" title="Modifier"><i class="bi bi-pencil-square"></i></a>
                      <form method="post" action="{{ path('categorie_produit_delete', {'id': category.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                        <button class="btn btn-danger btn-sm" title="Supprimer"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                {% else %}
                  <tr><td colspan="3" class="text-center">Aucune catégorie trouvée.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .table tbody tr { background-color: #f3f8ff !important; transition: background-color 0.3s ease; }
    .table tbody tr:hover { background-color: #e0e7ef !important; }
    .btn-info, .btn-warning, .btn-success { transition: all 0.3s ease; }
    .btn-info:hover { background-color: #17a2b8; border-color: #17a2b8; }
    .btn-warning:hover { background-color: #e0a800; border-color: #e0a800; }
    .btn-success:hover { background-color: #218838; border-color: #218838; }
  </style>
{% endblock %}