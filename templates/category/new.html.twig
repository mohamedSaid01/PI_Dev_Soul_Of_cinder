{% extends 'baseBackOffice.html.twig' %}

{% block title %}Nouvelle Catégorie{% endblock %}

{% block body %}
<main id="main" class="main">
  <div class="pagetitle mb-4">
    <h1 class="page-title"><i class="bi bi-tags"></i> Nouvelle Catégorie</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
        <li class="breadcrumb-item">Produits</li>
        <li class="breadcrumb-item active">Catégories</li>
      </ol>
    </nav>
  </div>
  <div class="row g-4">
    <div class="col-12">
      <div class="card glass-card p-0">
        <div class="card-body">
          <h3 class="card-title mb-4"><i class="bi bi-plus-circle"></i> Ajouter une catégorie</h3>
          {{ include('category/_form.html.twig') }}
          <a href="{{ path('app_category_index') }}" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .btn-secondary:hover { background-color: #6c757d; border-color: #6c757d; }
  </style>
{% endblock %}
