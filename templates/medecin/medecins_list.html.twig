{% extends 'baseBackOffice.html.twig' %}

{% block title %}List of Doctors - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table th {
            color: rgb(31, 31, 34);
            font-weight: 600;
            font-size: 15px;
        }

        .table td {
            font-weight: 400;
            font-size: 13px;
            color: #333;
        }

        .table {
            font-family: 'Poppins', sans-serif;
        }

        p {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
        }

        .btn-add {
            margin-bottom: 15px;
            background-color: #00B4D8;
            color: white;
            border: none;
            font-weight: 500;
            padding: 10px 20px;
            display: inline-block;
            text-align: center;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-add:hover {
            background-color: #90E0E6;
        }

        .search-bar {
            margin-bottom: 15px;
            width: 400px;
            position: relative;
        }

        .search-bar input {
            padding-left: 30px;
            padding-right: 30px;
            width: 100%;
        }

        .search-bar .bi-search {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .search-bar input::placeholder {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
            color: #6c757d;
        }

        .search-bar button {
            background-color: white;
            color: black;
            border-color: black;
            font-weight: 350;
            border-radius: 5px;
            cursor: pointer;
            height: 38px;
        }

        .search-bar button:hover {
            background-color: #90E0E6;
            border-color: #90E0E6;
        }

        /* Styles for pagination */
        .navigation {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .pagination {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 0;
            gap: 8px; /* Space between elements */
        }

        .pagination span,
        .pagination a {
            display: block;
            padding: 5px 7px;
            border: 1px solid #ddd;
            border-radius: 5px;
            color: #00B4D8;
            text-decoration: none;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            transition: background-color 0.3s, color 0.3s;
        }

        .pagination a:hover {
            background-color: #00B4D8;
            color: white;
            border-color: #00B4D8;
        }

        .pagination .current {
            background-color: #00B4D8;
            color: white;
            border-color: #00B4D8;
        }

        .pagination .disabled {
            color: #ddd;
            border-color: #ddd;
            cursor: not-allowed;
        }

        .pagination .next a,
        .pagination .last a {
            font-weight: bold;
        }
    </style>
{% endblock %}

{% block body %}
  <main id="main" class="main">
    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">List of Doctors</h5>
              <p>Find here the complete list of doctors registered in our system. You can view their information, edit or delete them if necessary.</p>

              <!-- Search form -->
              <div class="d-flex justify-content-between mb-4">
                  <form method="get" action="{{ path('app_medecins_list') }}" class="search-bar d-flex align-items-center">
                      <select name="specialite" class="form-select me-2" style="width: auto;">
                          <option value="" {% if selectedSpecialite is empty %}selected{% endif %}>All Specialties</option>
                          {% for specialite in specialites %}
                              <option value="{{ specialite }}" {% if specialite == selectedSpecialite %}selected{% endif %}>
                                  {{ specialite }}
                              </option>
                          {% endfor %}
                      </select>
                      <button type="submit" class="btn btn-primary">
                          Search
                      </button>
                  </form>

                  <div>
                      <a href="{{ path('app_new_register_medecin') }}" class="btn btn-success btn-sm btn-add me-0">
                          + Add a Doctor
                      </a>
                      <a href="{{ path('admin_user_list') }}" class="btn btn-success btn-sm btn-add">
                          List of Unaccepted Doctors
                      </a>
                  </div>
              </div>

              <!-- Doctors table -->
              <div class="container-fluid mt-4">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Last Name</th>
                                <th>First Name</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Phone Number</th>
                                <th>Specialty</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for medecin in medecins %}
                                <tr>
                                    <td>{{ medecin.lastName ? medecin.lastName : 'Not specified' }}</td>
                                    <td>{{ medecin.firstName ? medecin.firstName : 'Not specified' }}</td>
                                    <td>{{ medecin.email ? medecin.email : 'Not specified' }}</td>
                                    <td>{{ medecin.adress ? medecin.adress : 'Not specified' }}</td>
                                    <td>{{ medecin.phoneNumber ? medecin.phoneNumber : 'Not specified' }}</td>
                                    <td>
                                        {% if medecin.specialite is defined and medecin.specialite is not null %}
                                            {{ medecin.specialite.value }}
                                        {% else %}
                                            Not specified
                                        {% endif %}
                                    </td>
                                    <td>
                                        <!-- View button -->
                                        <a href="{{ path('app_medecin_show', {'id': medecin.id}) }}" class="btn btn-info btn-sm" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <!-- Edit button -->
                                        <a href="{{ path('app_medecin_edit', {'id': medecin.id}) }}" class="btn btn-warning btn-sm" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Delete button -->
                                        <form method="post" action="{{ path('app_medecin_delete', {'id': medecin.id}) }}" class="delete-form d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ medecin.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">No doctors found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="navigation">
                    {{ knp_pagination_render(medecins, null, {}, {
                        'prev_message': '<i class="bi bi-chevron-left"></i>',
                        'next_message': '<i class="bi bi-chevron-right"></i>',
                        'first_message': '<i class="bi bi-chevron-double-left"></i>',
                        'last_message': '<i class="bi bi-chevron-double-right"></i>'
                    }) }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}  {# This is critical - it loads all the scripts from the parent template #}

    <!-- Vendor JS Files -->
    <script src="{{ asset('assetsBackOffice/vendor/apexcharts/apexcharts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/chart.js/chart.umd.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/quill/quill.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/simple-datatables/simple-datatables.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/tinymce/tinymce.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/php-email-form/validate.js') }}"></script>

    <!-- Template Main JS File -->
    <script src="{{ asset('assetsBackOffice/js/main.js') }}"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize sidebar toggle functionality
            document.querySelector('.toggle-sidebar-btn').addEventListener('click', function() {
                document.querySelector('body').classList.toggle('toggle-sidebar');
            });
            
            // Fix sidebar navigation - highlight active item and show current submenu
            const currentPath = window.location.pathname;
            
            // Find all sidebar links
            document.querySelectorAll('#sidebar-nav .nav-link').forEach(link => {
                // For links with submenus (those with data-bs-toggle="collapse")
                if (link.hasAttribute('data-bs-toggle') && link.getAttribute('data-bs-toggle') === 'collapse') {
                    // Find all child links in the submenu
                    const submenu = link.getAttribute('data-bs-target');
                    const submenuLinks = document.querySelectorAll(`${submenu} a`);
                    
                    // Check if current page matches any submenu item
                    let isActiveSubmenu = false;
                    submenuLinks.forEach(subLink => {
                        if (subLink.getAttribute('href') === currentPath) {
                            isActiveSubmenu = true;
                            subLink.classList.add('active');
                        }
                    });
                    
                    // If a submenu item is active, expand the parent and remove 'collapsed' class
                    if (isActiveSubmenu) {
                        link.classList.remove('collapsed');
                        const targetId = submenu.substring(1); // Remove # from the id
                        const targetElement = document.getElementById(targetId);
                        if (targetElement) {
                            targetElement.classList.add('show');
                        }
                    }
                } 
                // For direct links without submenus
                else if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                    link.classList.remove('collapsed');
                }
            });
            
            // Delete confirmation
            document.querySelectorAll('.delete-form').forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        text: "Are you sure you want to delete this doctor?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#00B4D8',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}