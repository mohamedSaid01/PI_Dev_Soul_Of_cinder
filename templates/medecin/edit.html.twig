{# templates/medecin/edit.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}Modifier le Médecin - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .form-col {
            flex: 1;
            min-width: 250px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #00B4D8;
            box-shadow: 0 0 5px rgba(0, 180, 216, 0.5);
        }

        .btn-primary {
            background-color: #00B4D8;
            border-color: #00B4D8;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 8px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0096C7;
            border-color: #0096C7;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 8px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

        .text-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            font-family: 'Poppins', sans-serif;
        }

        p {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
        }
    </style>
{% endblock %}

{% block body %}
    <main id="main" class="main">
        <div class="card">
            <div class="card-body">
                <div class="form-container">
                    <h5 class="card-title">Modifier le Médecin</h5>
                    <p>Utilisez ce formulaire pour modifier les informations du médecin.<br>Assurez-vous de remplir tous les champs requis pour mettre à jour correctement le médecin.</p>

                    {{ form_start(form, {'attr': {'class': 'form', novalidate: 'novalidate'}}) }}
                        <div class="form-row">
                            <!-- Colonne de gauche -->
                            <div class="form-col">
                                <div class="form-group">
                                    {{ form_label(form.firstName, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.firstName) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.adress, 'Adresse', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.adress, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.adress) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.numeroLicence, 'Numéro de Licence', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.numeroLicence, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.numeroLicence) }}
                                </div>
                            </div>

                            <!-- Colonne de droite -->
                            <div class="form-col">
                                <div class="form-group">
                                    {{ form_label(form.lastName, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.lastName) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.phoneNumber, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.phoneNumber) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.gender, 'Genre', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.gender, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.gender) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.specialite, 'Spécialité', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.specialite, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.specialite) }}
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                            <a href="{{ path('app_medecins_list') }}" class="btn btn-secondary">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}