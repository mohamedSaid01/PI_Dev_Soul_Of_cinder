{# templates/medecin/edit.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}Edit Doctor - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}  <!-- This calls the styles from the parent template -->
    <style>
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .form-col {
            flex: 1;
            min-width: 250px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #00B4D8;
            box-shadow: 0 0 5px rgba(0, 180, 216, 0.5);
        }

        .btn-primary {
            background-color: #00B4D8;
            border-color: #00B4D8;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 8px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0096C7;
            border-color: #0096C7;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 8px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }

        .text-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            font-family: 'Poppins', sans-serif;
        }

        p {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
        }

        /* Align the button with the "Age" field */
        .form-row .form-group.btn-group {
            margin-top: 30px; /* Adjust spacing if necessary */
        }

        /* Keep the button size */
        .form-group button {
            width: auto;
            height: auto;
        }
    </style>
{% endblock %}

{% block body %}
    <main id="main" class="main">
        <div class="card">
            <div class="card-body">
                <div class="form-container">
                    <h5 class="card-title">Edit Doctor</h5>
                    <p>Use this form to edit the doctor's information.<br>Make sure to fill in all required fields to update the doctor correctly.</p>

                    {{ form_errors(form) }}

                    {{ form_start(form, {'attr': {'class': 'form', novalidate: 'novalidate'}}) }}
                        <div class="form-row">
                            <!-- Left Column -->
                            <div class="form-col">
                                <div class="form-group">
                                    <label>First Name</label>
                                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Enter first name'}}) }}
                                    {{ form_errors(form.firstName) }}
                                </div>
                                <div class="form-group">
                                    <label>Email</label>
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter email'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                                <div class="form-group">
                                    <label>Address</label>
                                    {{ form_widget(form.adress, {'attr': {'class': 'form-control', 'placeholder': 'Enter address'}}) }}
                                    {{ form_errors(form.adress) }}
                                </div>
                                <div class="form-group">
                                    <label>License Number</label>
                                    {{ form_widget(form.numeroLicence, {'attr': {'class': 'form-control', 'placeholder': 'Format: ABC12345 (3 letters followed by 5 digits)'}}) }}
                                    {{ form_errors(form.numeroLicence) }}
                                </div>
                                <div class="form-group">
                                    <label>Age</label>
                                    {{ form_widget(form.age, {'attr': {'class': 'form-control', 'placeholder': 'Enter age'}}) }}
                                    {{ form_errors(form.age) }}
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="form-col">
                                <div class="form-group">
                                    <label>Last Name</label>
                                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Enter last name'}}) }}
                                    {{ form_errors(form.lastName) }}
                                </div>
                                <div class="form-group">
                                    <label>Phone Number</label>
                                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': 'Enter phone number'}}) }}
                                    {{ form_errors(form.phoneNumber) }}
                                </div>
                                <div class="form-group">
                                    <label>Gender</label>
                                    {{ form_widget(form.gender, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.gender) }}
                                </div>
                                <div class="form-group">
                                    <label>Specialty</label>
                                    {{ form_widget(form.specialite, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.specialite) }}
                                </div>

                                <!-- "Save" and "Cancel" Buttons -->
                                <div class="form-group btn-group">
                                    <a href="{{ path('app_medecins_list') }}" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left"></i> Back to List
                                    </a>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </div>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}