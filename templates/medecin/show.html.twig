{# templates/medecin/show.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}Doctor Details - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="{{ asset('assetsBackOffice/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/boxicons/css/boxicons.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/quill/quill.snow.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/quill/quill.bubble.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/remixicon/remixicon.css') }}" rel="stylesheet">
    <link href="{{ asset('assetsBackOffice/vendor/simple-datatables/style.css') }}" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="{{ asset('assetsBackOffice/css/style.css') }}" rel="stylesheet">

    <!-- Favicon -->
    <link href="{{ asset('assetsBackOffice/img/favicon.png') }}" rel="icon">
    <link href="{{ asset('assetsBackOffice/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

    <style>
        .label {
            color: rgb(31, 31, 34);
            font-weight: 600;
            font-size: 16px;
        }
    </style>
{% endblock %}

{% block body %}
    <main id="main" class="main">
        <div class="container mt-5">
            <div class="card">
                <div class="card-body">
                    <!-- Section "About" -->
                    <div class="tab-pane fade show active profile-overview" id="profile-overview">
                        <h5 class="card-title">About</h5>
                        <p class="small fst-italic" style="font-family: 'Poppins', sans-serif; font-weight: 200; font-size: 13px;">
                            Find here the complete details of the doctor. You can view their personal and professional information.
                        </p>

                        <h5 class="card-title">Profile Details</h5>

                        <!-- Full Name -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Full Name</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.firstName }} {{ medecin.lastName }}</div>
                        </div>

                        <!-- Email -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Email</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.email }}</div>
                        </div>

                        <!-- Gender -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Gender</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.gender ? medecin.gender.value : 'Not specified' }}</div>
                        </div>

                        <!-- Address -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Address</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.adress }}</div>
                        </div>

                        <!-- Phone Number -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Phone Number</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.phoneNumber }}</div>
                        </div>

                        <!-- License Number -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">License Number</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.numeroLicence }}</div>
                        </div>

                        <!-- Age -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Age</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.age ?? 'Not specified' }}</div>
                        </div>

                        <!-- Specialty -->
                        <div class="row">
                            <div class="col-lg-3 col-md-4 label">Specialty</div>
                            <div class="col-lg-9 col-md-8">{{ medecin.specialite ? medecin.specialite.value : 'Not specified' }}</div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-4">
                        <a href="{{ path('app_medecins_list') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <a href="{{ path('app_medecin_edit', {'id': medecin.id}) }}" class="btn btn-warning" style="background-color: #00B4D8; color: white; border: none;">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <!-- Vendor JS Files -->
    <script src="{{ asset('assetsBackOffice/vendor/apexcharts/apexcharts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/chart.js/chart.umd.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/quill/quill.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/simple-datatables/simple-datatables.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/tinymce/tinymce.min.js') }}"></script>
    <script src="{{ asset('assetsBackOffice/vendor/php-email-form/validate.js') }}"></script>

    <!-- Template Main JS File -->
    <script src="{{ asset('assetsBackOffice/js/main.js') }}"></script>
{% endblock %}