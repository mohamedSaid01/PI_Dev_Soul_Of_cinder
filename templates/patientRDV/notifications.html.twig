{# templates/patient/notifications.html.twig #}
{% block stylesheets %}
<style>
    .notifications {
        max-width: 400px; /* Largeur maximale pour le conteneur des notifications */
        max-height: 500px; /* Hauteur maximale pour le défilement */
        overflow-y: auto; /* Active le défilement vertical */
        overflow-x: hidden; /* Désactive le défilement horizontal */
        border: 1px solid #e0e0e0; /* Bordure autour des notifications */
        border-radius: 8px; /* Coins arrondis */
        background-color: #f8f9fa; /* Couleur de fond douce */
        padding: 10px; /* Espacement interne */
    }

    .notification-item {
        padding: 15px; /* Espacement interne pour chaque notification */
        border-bottom: 1px solid #e0e0e0; /* Ligne de séparation entre les notifications */
        font-size: 14px; /* Taille de police fine */
        color: #333; /* Couleur du texte */
        transition: background-color 0.3s; /* Effet de transition sur le survol */
        position: relative; /* Pour positionner le lien "Marquer comme lu" */
    }

    .notification-item:last-child {
        border-bottom: none; /* Pas de ligne de séparation pour le dernier élément */
    }

    .notification-item:hover {
        background-color: #e9ecef; /* Couleur de fond au survol */
    }

    .mark-read {
        position: absolute; /* Positionnement absolu pour le lien */
        right: 15px; /* Alignement à droite */
        top: 15px; /* Alignement vertical */
        font-size: 12px; /* Taille de police pour le lien */
        color: #007bff; /* Couleur du lien */
        text-decoration: none; /* Pas de soulignement */
        transition: color 0.3s; /* Transition sur la couleur */
    }

    .mark-read:hover {
        color: #0056b3; /* Couleur au survol */
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.5); /* Couleur des flèches */
    }

    .carousel-item p {
        text-align: center; /* Centrer le texte pour les notifications vides */
        font-size: 16px; /* Taille de police pour le message vide */
        color: #999; /* Couleur du texte pour le message vide */
    }
</style>
{% endblock %}

{% block body %}
    <h3>Notifications</h3>

    <div class="notifications">
        {% if notifications is empty %}
            <p>Aucune notification.</p>
        {% else %}
            <ul>
                {% for notification in notifications %}
                    <li class="notification-item">
                        {{ notification.message }} 
                        <a href="{{ path('mark_notification_read', { 'id': notification.id }) }}" class="mark-read">✅</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}