{% extends 'base.html.twig' %}

{% block title %}Reclamation{% endblock %}

{% block body %}
    <h1>Reclamation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reclamation.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ reclamation.description }}</td>
            </tr>
            <tr>
                <th>Date_reclamation</th>
                <td>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Idmedecin</th>
                <td>{{ reclamation.idmedecin }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ reclamation.photo }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reclamation_controller_php_index') }}">back to list</a>

    <a href="{{ path('app_reclamation_controller_php_edit', {'id': reclamation.id}) }}">edit</a>

    {{ include('reclamation_controller_php/_delete_form.html.twig') }}
{% endblock %}
