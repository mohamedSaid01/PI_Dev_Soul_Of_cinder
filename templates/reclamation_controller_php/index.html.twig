{% extends 'baseFrontOffice.html.twig' %}

{% block title %}Gestion des Réclamations{% endblock %}


{% block stylesheets %}
 {{ parent() }}
<style>
  .reclamation-index-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 20px;
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  h1 {
    text-align: center;
    color: #2c3e50;
    margin-bottom: 30px;
    font-size: 28px;
    font-weight: 600;
  }

  .table-responsive {
    border-radius: 12px;
    overflow: hidden;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
  }

  .table th {
    background-color: #00B4D8;
    color: white;
    font-weight: 500;
    text-align: center;
  }

  .table td {
    text-align: center;
    vertical-align: middle;
    padding: 12px;
  }

  .table tr:hover {
    background-color: #f9f9f9;
  }

  .table td img {
    max-width: 80px;
    border-radius: 5px;
  }

  .actions a {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 5px;
    text-decoration: none;
    color: white;
    background-color: #00B4D8;
    transition: 0.3s ease;
  }

  .actions a:hover {
    background-color: #0099b3;
    transform: scale(1.05);
  }

  .create-new-link {
    display: block;
    width: fit-content;
    margin: 20px auto;
    padding: 12px 24px;
    background-color: #00B4D8;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-size: 16px;
    transition: 0.3s ease;
  }

  .create-new-link:hover {
    background-color: #0099b3;
    transform: scale(1.05);
  }

  .no-records {
    text-align: center;
    color: #888;
    font-style: italic;
    padding: 20px;
  }
</style>
{% endblock %}


{% block body %}
  <main id="main" class="main">
    <body style="background-color: white;">
        <style>
            .navbar-nav {
                display: flex;
                align-items: center; /* Centre verticalement */
                justify-content: center; /* Centre horizontalement */
                width: 100%;
            }
            .navbar-nav .nav-item {
                position: relative;
                padding-right: 20px; /* Espacement entre les éléments */
                padding-left: 20px;
                text-align: center; 
            }

            .navbar-nav .nav-item:not(:last-child)::after {
                content: "";
                position: absolute;
                top: 50%;
                right: 0;
                transform: translateY(-50%);
                width: 2px;  /* Largeur de la ligne */
                height: 20px; /* Hauteur de la ligne */
                background-color: #ccc; /* Couleur de la ligne */
            }

           
        </style>



<form class="search-form mb-3 mb-lg-0" role="search" action="{{ path('reclamation_search') }}" method="GET">
                            <svg class="search primary-color position-absolute" width="18" height="18">
                                <use xlink:href="#search"></use>
                            </svg>
                            <input class="form-control border-0 ps-4 position-relative" 
                                    type="search" 
                                    placeholder="Search.." 
                                    aria-label="Search"
                                    id="search-input"
                                    name="q">
                        </form>




<div class="container py-4">
    <div class="reclamation-index-container bg-light p-4 rounded shadow">
        <h1> Liste des Réclamations</h1>

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
            <span class="text-muted fs-5">
                Total Réclamations: <strong class="text-dark">{{ reclamations|length }}</strong>
            </span>

            <form action="{{ path('app_reclamation_controller_php_index') }}" method="get" class="d-flex align-items-center">
                <label for="typeReclamationFilter" class="form-label me-2 fw-bold">Filtrer par Type:</label>
                <select name="typeReclamation" id="typeReclamationFilter" class="form-select w-auto" onchange="this.form.submit()">
                    <option value="">Tous les types</option>
                    {% for typeReclamation in typesReclamation %}
                        <option value="{{ typeReclamation.id }}" {% if selectedType == typeReclamation.id %}selected{% endif %}>
                            {{ typeReclamation.typeReclamation }}
                        </option>
                    {% endfor %}
                </select>
            </form>
        </div>
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Date Réclamation</th>
                <th>Médecin</th>
                <th>Photo</th>
                <th>Type Réclamation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reclamation in reclamations %}
                <tr>
                    <td>{{ reclamation.description }}</td>
                    <td>{{ reclamation.dateReclamation ? reclamation.dateReclamation|date('Y-m-d H:i:s') : '' }}</td>
                    <td>
    {% if reclamation.medecin and reclamation.medecin.user %}
        {{ reclamation.medecin.user.firstName ~ ' ' ~ reclamation.medecin.user.lastName }}
    {% else %}
        N/A
    {% endif %}
</td>

                    <td>
                        {% if reclamation.photo %}
                            <img src="{{ asset('uploads/images/' ~ reclamation.photo) }}" alt="Photo" style="max-width: 100px;">
                        {% else %}
                            N/A
                        {% endif %}
                    </td>
                    <td>{{ reclamation.typeReclamation ? reclamation.typeReclamation.typeReclamation : 'N/A' }}</td>
                    <td class="actions">
                        <a href="{{ path('app_reclamation_controller_php_show', {'id': reclamation.id}) }}">Voir</a>
                        <a href="{{ path('app_reclamation_controller_php_edit', {'id': reclamation.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="no-records">Aucune réclamation trouvée</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{# {% for reclamation in reclamations %}
    <a href="{{ path('app_reponse_controller_php_new', {'id': reclamation.id}) }}" class="btn btn-primary">Ajouter une réponse</a>
{% endfor %} #}

   {% for reclamation in reclamations|slice(0,1) %}
    <a href="{{ path('app_reclamation_controller_php_new', {'id': reclamation.id}) }}" class="btn btn-primary">Réclamation</a>
{% endfor %}

</div>
</main>
{% endblock %}

{% block javascripts %}
  {% block importmap %}{{ importmap('app') }}{% endblock %}
<script>
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('search-input').addEventListener('keypress', function(event) {
                if (event.key === 'Enter') {
                    let query = this.value;

                    fetch('/reclamation/controller/php/reclamations/search?q=' + query, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.text())
                    .then(data => {
                        document.getElementById('search-results').innerHTML = data;
                    });
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('search-by-type').addEventListener('click', function() {
                const type = document.getElementById('type-select').value;

                if (type) {
                    fetch(/reclamations/type/${type}, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.text())
                    .then(data => {
                        document.getElementById('reclamations-table').innerHTML = data;
                    });
                } else {
                    alert('Veuillez sélectionner un type de réclamation.');
                }
            });
        });


            function toggleNotificationPopup() {
                const popup = document.getElementById('notificationPopup');
                popup.classList.toggle('active');
            }
        </script>
  {% endblock %}