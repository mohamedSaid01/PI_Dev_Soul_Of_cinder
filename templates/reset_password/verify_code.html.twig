{% extends 'base.html.twig' %}

{% block title %}Verify Code{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-3/assets/css/login-3.css">
    <style>
        html, body {
            overflow: hidden;
            height: 100%;
            margin: 0;
        }
        .login-page {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container-fluid, .row {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
        }
        .col-6 {
            flex: 0 0 50%;
            max-width: 50%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }
        .form-control-full-width, 
        .btn-full-width {
            width: 43rem 
        }
    </style>
{% endblock %}

{% block body %}
    <section class="login-page">
        <div class="container-fluid">
            <div class="row g-0">
                <div class="col-6" style="background-color: #CAF0F8; border-color: #CAF0F8;">
                    <div class="d-flex justify-content-center align-items-center h-100 p-3 p-md-4 p-xl-5">
                        <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/undraw_verified_m721.svg') }}" width="245" height="80" alt="Forgot Password">
                    </div>
                </div>
                <div class="col-6 bsb-tpl-bg-lotion">
                    <div class="p-3 p-md-4 p-xl-5">
                        <div class="d-flex flex-column align-items-center">
                            <img class="img-fluid rounded" loading="lazy" src="{{ asset('assetsBackOffice/img/logo.png') }}" width="100" height="80" alt="Logo">
                            <h3>Reset Password</h3>
                        </div>
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger" role="alert">{{ message }}</div>
                        {% endfor %}
                        {{ form_start(form, {'attr': {'class': 'row gy-3 gy-md-4 overflow-hidden', 'novalidate': 'novalidate'}}) }}
                            <div class="col-12">
                                <label for="code">Code</label>
                                {{ form_widget(form.code, {'attr': {'class': 'form-control form-control-full-width', 'id': 'code'}}) }}
                                {{ form_errors(form.code) }}
                                <small class="text-muted">
                                    Verify your email and enter your reset code.
                                </small>
                            </div>
                            <div class="col-12">
                                <div class="d-grid">
                                    <button type="submit" class="btn bsb-btn-xl text-white btn-full-width" style="background-color: #00B4D8; border-color: #00B4D8; padding: 8px 16px; font-size: 14px;">Enter reset code</button>
                                </div>
                            </div>
                        {{ form_end(form) }}
                        <div class="row">
                            <div class="col-12">
                                <hr class="border-secondary-subtle">
                                <div class="text-end">
                                    <a href="{{ path('app_login') }}" class="link-secondary text-decoration-none">Back to login</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
