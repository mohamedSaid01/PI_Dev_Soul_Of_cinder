{# templates/emails/verification_code.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification Code - SAHATECK</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
        }
        .container {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        h1 {
            color: #0056b3;
            font-size: 24px;
            margin-bottom: 20px;
        }
        p {
            margin: 0 0 15px;
        }
        .code {
            font-size: 20px;
            font-weight: bold;
            color: #0056b3;
            padding: 10px;
            background-color: #e9f5ff;
            border-radius: 4px;
            text-align: center;
            margin: 20px 0;
        }
        .footer {
            margin-top: 20px;
            font-size: 14px;
            color: #777;
            text-align: center;
        }
        .footer a {
            color: #0056b3;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Verification Code</h1>
        <p>Hello <strong>{{ user.firstName }} {{ user.lastName }}</strong>,</p>
        <p>You have requested to reset your password on <strong>SAHATECK</strong>. Here is your verification code:</p>
        <div class="code">{{ resetRequest.code }}</div>
        <p>This code is valid for a limited time. If you did not make this request, please ignore this email.</p>
        <p>Best regards,</p>
        <p><strong>The SAHATECK Team</strong></p>
    </div>
    <div class="footer">
        <p>If you encounter any issues, please contact us at <a href="mailto:support@sahateck.com">support@sahateck.com</a>.</p>
        <p>&copy; {{ "now"|date("Y") }} SAHATECK. All rights reserved.</p>
    </div>
</body>
</html>