{% extends 'baseBackOffice.html.twig' %}

{% block title %}Modifier l'événement{% endblock %}

{% block stylesheets %}
{{ parent() }}
<!-- SweetAlert2 CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
// Fonction de secours si SweetAlert2 n'est pas chargé
if (typeof Swal === 'undefined') {
    window.Swal = {
        fire: function(options) {
            if (options.icon === 'error' || options.icon === 'warning') {
                alert(options.title + "\n" + options.text);
            } else {
                console.log(options);
            }
        },
        showLoading: function() {},
        close: function() {}
    };
}
</script>
{% endblock %}

{% block body %}
    <main id="main" class="main">

  <div class="pagetitle">
    <h1>Modifier l'événement</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('back_event_index') }}">Accueil</a></li>
        <li class="breadcrumb-item">Événements</li>
        <li class="breadcrumb-item active">Modifier</li>
      </ol>
    </nav>
  </div>

  <section class="section">
    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="form-group">
                {{ form_label(form.title, 'Titre') }}
                {{ form_widget(form.title, {'attr': {'class': 'form-control', 'id': 'event_title'}}) }}
                <span class="text-danger">{{ form_errors(form.title) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.description, 'Description') }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'id': 'event_description'}}) }}
                <span class="text-danger">{{ form_errors(form.description) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.startDate, 'Date de début') }}
                {{ form_widget(form.startDate, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.startDate) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.endDate, 'Date de fin') }}
                {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.endDate) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.location, 'Lieu') }}
                {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.location) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.latitude, 'Latitude') }}
                {{ form_widget(form.latitude, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.latitude) }}</span>
            </div>

            <div class="form-group">
                {{ form_label(form.longitude, 'Longitude') }}
                {{ form_widget(form.longitude, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.longitude) }}</span>
            </div>

              <div class="form-group">
                  {{ form_label(form.placesDisponibles, 'Places disponibles') }}
                  {{ form_widget(form.placesDisponibles, {'attr': {'class': 'form-control'}}) }}
                  <span class="text-danger">{{ form_errors(form.placesDisponibles) }}</span>
              </div>

            <div class="form-group">
                {{ form_label(form.categorie, 'Catégorie') }}
                {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                <span class="text-danger">{{ form_errors(form.categorie) }}</span>
            </div>

            <!-- Section affiche avec boutons de génération d'image -->
            <div class="form-group mb-4">
                <label for="event_image" class="form-label fw-semibold">Affiche de l'événement</label>
                
                <div class="d-flex flex-column">
                    <!-- Affiche actuelle -->
                    {% if event.affiche %}
                        <div class="mb-3">
                            <label>Affiche actuelle :</label><br>
                            <img src="{{ asset('uploads/affiches/' ~ event.affiche) }}" alt="Affiche" style="max-width: 180px; border-radius: 8px; box-shadow: 0 2px 8px #0001;">
                        </div>
                    {% else %}
                        <p class="text-warning mb-3">Aucune affiche disponible.</p>
                    {% endif %}
                    
                    <!-- Boutons de génération d'image -->
                    <div class="d-flex flex-column flex-md-row align-items-start gap-3 mb-3">
                        <!-- Bouton Stability AI -->
                        <button type="button" id="generate-stability-image" class="btn btn-primary mb-2 mb-md-0">
                            <i class="fa fa-wand-magic-sparkles me-2"></i> Générer une affiche automatiquement
                        </button>
                        <!-- Prévisualisation de la nouvelle image -->
                        <img id="event_image_preview" src="" alt="Prévisualisation de l'affiche" style="max-width: 180px; border-radius: 8px; box-shadow: 0 2px 8px #0001; display: none;">
                        <!-- Champ caché pour stocker le nom de l'image générée -->
                        <input type="hidden" id="generated_image_name" name="generated_image_name" value="">
                    </div>
                    
                    <!-- Téléchargement manuel -->
                    <div>
                        {{ form_label(form.afficheFile, 'Ou télécharger une nouvelle affiche') }}
                        {{ form_widget(form.afficheFile, {'attr': {'class': 'form-control'}}) }}
                        <span class="text-danger">{{ form_errors(form.afficheFile) }}</span>
                    </div>
                </div>
            </div>
            
            <br>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('back_event_index') }}" class="btn btn-secondary">Retour à la liste</a>
            {{ form_end(form) }}
          </div>
        </div>
      </div>
    </div>
  </section>
  
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Générer une image avec Stability AI
        document.getElementById('generate-stability-image').addEventListener('click', function () {
            const title = document.getElementById('event_title').value;
            const description = document.getElementById('event_description').value;
            const imagePreview = document.getElementById('event_image_preview');
            const generatedImageNameField = document.getElementById('generated_image_name');

            if (!title) {
                alert('Veuillez entrer un titre avant de générer une image.');
                return;
            }
            
            // Changer le texte du bouton pendant le chargement
            this.disabled = true;
            this.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Génération en cours...';
            
            // Afficher un message de chargement
            Swal.fire({
                title: 'Génération en cours',
                text: 'La génération peut prendre jusqu\'à 30 secondes...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            fetch('/event/api/generate-stability-image', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ 
                    title: title,
                    description: description
                }),
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erreur serveur');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        // Fermer le message de chargement
                        Swal.close();
                        
                        // Afficher l'image générée
                        imagePreview.src = data.image_url;
                        imagePreview.style.display = 'block';
                        
                        // Stocker le nom de l'image générée
                        generatedImageNameField.value = data.image_name;
                        
                        // Afficher un message de succès
                        Swal.fire({
                            title: 'Succès !',
                            text: 'L\'image a été générée avec succès.',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        throw new Error(data.error || 'Erreur inconnue');
                    }
                    
                    // Réactiver le bouton
                    this.disabled = false;
                    this.innerHTML = '<i class="fa fa-wand-magic-sparkles me-2"></i> Générer une affiche automatiquement';
                })
                .catch(error => {
                    console.error('Erreur lors de la génération de l\'image :', error);
                    
                    // Fermer le message de chargement
                    Swal.close();
                    
                    // Afficher un message d'erreur
                    Swal.fire({
                        title: 'Erreur',
                        text: 'Une erreur est survenue lors de la génération de l\'image : ' + error.message,
                        icon: 'error'
                    });
                    
                    // Réactiver le bouton
                    this.disabled = false;
                    this.innerHTML = '<i class="fa fa-wand-magic-sparkles me-2"></i> Générer une affiche automatiquement';
                });
        });
    });
</script>
{% endblock %}
