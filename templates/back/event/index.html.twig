{% extends 'baseBackOffice.html.twig' %}
{% block title %}Gestion des Événements{% endblock %}
{% block body %}
  <main id="main" class="main">
    <div class="main-content-glass">
        <div class="pagetitle mb-4">
            <h1 class="page-title"><i class="bi bi-calendar-event"></i> Gestion des Événements</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">🏠 Accueil</a></li>
                    <li class="breadcrumb-item">📂 Tables</li>
                    <li class="breadcrumb-item active">📅 Événements</li>
                </ol>
            </nav>
        </div>
        <div class="row g-4">
            <div class="col-12">
                <div class="card glass-card p-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="card-title mb-0"><i class="bi bi-list-task"></i> Liste des Événements</h3>
                            <a href="{{ path('back_event_new') }}" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Créer un nouvel événement
                            </a>
                        </div>
                        <!-- 🎯 Formulaire de filtrage -->
                        <form id="search-form" class="mb-4">
                            <input type="hidden" name="isArchived" id="isArchived" value="false"> <!-- ✅ Identifie si on cherche dans actifs ou archivés -->

                            <div class="row g-2">
                                <div class="col-md-3">
                                    <input type="text" class="form-control" name="title" placeholder="Titre">
                                </div>
                                <div class="col-md-3">
                                    <input type="date" class="form-control" name="startDate">
                                </div>
                                <div class="col-md-3">
                                    <select class="form-control" name="categorie">
                                        <option value="">Toutes les catégories</option>
                                        {% for categorie in categories %}
                                            <option value="{{ categorie.id }}">{{ categorie.nom }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-search"></i> Rechercher
                                    </button>
                                </div>
                            </div>
                        </form>
                        <!-- 🏷️ Onglets -->
                        <ul class="nav nav-tabs" id="eventTabs">
                            <li class="nav-item">
                                <a class="nav-link active fw-bold" id="active-tab" data-bs-toggle="tab" href="#active-events">
                                    <i class="bi bi-calendar-check"></i> Événements Actifs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-danger" id="archived-tab" data-bs-toggle="tab" href="#archived-events">
                                    <i class="bi bi-archive-fill"></i> Événements Archivés
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content mt-3">
                            <!-- ✅ Événements actifs -->
                            <div class="tab-pane fade show active" id="active-events">
                                <div id="active-events-container">
                                    <!-- 🔄 Spinner visible pendant la recherche -->
                                    <div id="loading-spinner-active" class="text-center my-3 d-none">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Chargement...</span>
                                        </div>
                                        <p>Recherche en cours...</p>
                                    </div>

                                    {{ include('back/event/_event_table.html.twig', {'events': events_active, 'isArchived': false, 'pagination': pagination_active}) }}
                                </div>
                            </div>

                            <!-- ❌ Événements archivés -->
                            <div class="tab-pane fade" id="archived-events">
                                <div id="archived-events-container">
                                    <!-- 🔄 Spinner visible pendant la recherche -->
                                    <div id="loading-spinner-archived" class="text-center my-3 d-none">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Chargement...</span>
                                        </div>
                                        <p>Recherche en cours...</p>
                                    </div>
                                    <div class="table-responsive-archived border-0">
                                        {{ include('back/event/_event_table.html.twig', {'events': events_archived, 'isArchived': true, 'pagination': pagination_archived}) }}
                                    </div>
                                </div>
                            </div>
                        </div><!-- /tab-content -->
                    </div> <!-- /card-body -->
                </div> <!-- /card -->
            </div> <!-- /col-12 -->
        </div> <!-- /row -->
    </div> <!-- /main-content-glass -->
    <!-- 🎯 Script Ajax pour filtrer les événements -->
    <script>
        document.querySelectorAll('.nav-tabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function () {
                let isArchived = this.getAttribute('id') === "archived-tab";
                document.getElementById('isArchived').value = isArchived ? "true" : "false";
                
                // Réinitialiser la pagination lorsqu'on change d'onglet
                if (isArchived) {
                    // Si on passe aux archivés, réinitialiser page_archived
                    if (window.location.search.includes('page_archived')) {
                        const url = new URL(window.location);
                        url.searchParams.set('page_archived', '1');
                        history.replaceState(null, '', url);
                    }
                } else {
                    // Si on passe aux actifs, réinitialiser page_active
                    if (window.location.search.includes('page_active')) {
                        const url = new URL(window.location);
                        url.searchParams.set('page_active', '1');
                        history.replaceState(null, '', url);
                    }
                }
            });
        });

        // Fonction pour gérer la pagination AJAX
        function setupPaginationLinks() {
            document.querySelectorAll('.pagination-container .pagination a').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    // Récupérer l'URL complète du lien
                    const linkUrl = this.getAttribute('href');
                    if (!linkUrl) {
                        console.error("Erreur: URL du lien de pagination manquante");
                        return;
                    }
                    
                    try {
                        // Extraire le numéro de page du lien
                        const url = new URL(linkUrl, window.location.origin);
                        let page = 1;
                        let paramName = '';
                        
                        // Déterminer quel paramètre de page utiliser en fonction de l'onglet actif
                        const isArchived = document.getElementById('archived-tab').classList.contains('active');
                        
                        if (isArchived) {
                            paramName = 'page_archived';
                            // Extraire le numéro de page de l'URL
                            if (url.searchParams.has('page_archived')) {
                                page = parseInt(url.searchParams.get('page_archived')) || 1;
                            } else if (url.searchParams.has('page')) {
                                page = parseInt(url.searchParams.get('page')) || 1;
                            }
                        } else {
                            paramName = 'page_active';
                            // Extraire le numéro de page de l'URL
                            if (url.searchParams.has('page_active')) {
                                page = parseInt(url.searchParams.get('page_active')) || 1;
                            } else if (url.searchParams.has('page')) {
                                page = parseInt(url.searchParams.get('page')) || 1;
                            }
                        }
                        
                        // S'assurer que la page est un nombre valide
                        if (isNaN(page) || page < 1) {
                            page = 1;
                        }
                        
                        console.log("Navigation vers la page:", page, "paramètre:", paramName, "URL:", linkUrl, "Archivé:", isArchived);
                        
                        // Stocker la page courante dans un attribut data sur le conteneur
                        const containerId = isArchived ? 'archived-events-container' : 'active-events-container';
                        const tabPane = document.getElementById(containerId);
                        if (tabPane) {
                            tabPane.setAttribute('data-current-page', page);
                            console.log(`Conteneur ${containerId} page mise à jour:`, page);
                        } else {
                            console.error(`Conteneur ${containerId} non trouvé!`);
                            return; // Arrêter l'exécution si le conteneur n'est pas trouvé
                        }
                        
                        // Sauvegarder l'URL en cas d'échec de l'AJAX
                        const originalUrl = linkUrl;
                        
                        // Récupérer le formulaire de recherche
                        let formData = new FormData(document.getElementById('search-form'));
                        
                        // Important: toujours ajouter ces paramètres dans cet ordre
                        formData.append('isArchived', isArchived ? "true" : "false");
                        formData.append('page', page);
                        formData.append('pageParamName', paramName);
                        
                        // Afficher toutes les données du formulaire pour débogage
                        console.log("--- Début des données du formulaire ---");
                        for (var pair of formData.entries()) {
                            console.log(pair[0] + ': ' + pair[1]);
                        }
                        console.log("--- Fin des données du formulaire ---");
                        
                        // Effectuer la recherche avec le numéro de page
                        let ajaxSuccess = false;
                        
                        performSearch(formData)
                            .then(() => {
                                ajaxSuccess = true;
                                // Mettre à jour l'URL du navigateur sans recharger la page
                                history.pushState({}, '', originalUrl);
                            })
                            .catch(error => {
                                console.error("Erreur lors de la recherche AJAX:", error);
                                
                                // Si l'AJAX échoue, naviguer vers l'URL directement
                                if (!ajaxSuccess) {
                                    console.log("Fallback: Navigation directe vers", originalUrl);
                                    window.location.href = originalUrl;
                                }
                            });
                    } catch (error) {
                        console.error("Erreur lors du traitement de l'URL:", error);
                        // En cas d'erreur, rediriger vers le lien normalement
                        window.location.href = linkUrl;
                    }
                });
            });
        }

        document.getElementById('search-form').addEventListener('submit', function (e) {
            e.preventDefault();
            let formData = new FormData(this);
            
            // Récupérer le numéro de page actuel et l'ajouter à la requête
            let isArchived = document.getElementById('isArchived').value === "true";
            let containerID = isArchived ? 'archived-events-container' : 'active-events-container';
            let container = document.getElementById(containerID);
            let currentPage = 1;
            
            if (container && container.hasAttribute('data-current-page')) {
                currentPage = container.getAttribute('data-current-page');
            }
            
            let paramName = isArchived ? 'page_archived' : 'page_active';
            formData.append('page', currentPage);
            formData.append('pageParamName', paramName);
            
            console.log("Soumission du formulaire avec la page:", currentPage);
            
            performSearch(formData)
                .then(result => {
                    console.log("Recherche réussie");
                })
                .catch(error => {
                    console.error("Erreur lors de la recherche:", error);
                });
        });
        
        function performSearch(formData) {
            let isArchived = document.getElementById('isArchived').value === "true";
            let eventsContainerId = isArchived ? 'archived-events-container' : 'active-events-container';
            let spinnerId = isArchived ? 'loading-spinner-archived' : 'loading-spinner-active';
            let eventsContainer = document.getElementById(eventsContainerId);

            // Si le container est introuvable, afficher une erreur et arrêter le script
            if (!eventsContainer) {
                console.error("Erreur: eventsContainer introuvable !");
                return Promise.reject(new Error("Container d'événements introuvable"));
            }

            // Vérifier si le spinner existe déjà, sinon le recréer
            let spinner = document.getElementById(spinnerId);
            if (!spinner) {
                spinner = document.createElement('div');
                spinner.id = spinnerId;
                spinner.className = "text-center my-3";
                spinner.innerHTML = `
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p>Recherche en cours...</p>
        `;
            }

            // Insérer le spinner avant de vider le contenu
            eventsContainer.innerHTML = ''; // Vider le conteneur des résultats
            eventsContainer.appendChild(spinner); // Ajouter le spinner au DOM
            spinner.classList.remove('d-none'); // Rendre le spinner visible

            // Pour débogage
            const formEntries = {};
            for (let pair of formData.entries()) {
                formEntries[pair[0]] = pair[1];
            }
            console.log("Form data:", formEntries);

            // Retourner la promesse pour permettre l'utilisation de .then() et .catch()
            return fetch("{{ path('back_event_search') }}", {
                method: 'POST',
                body: formData
            })
            .then(response => {
                console.log("Réponse du serveur:", response.status, response.statusText);
                if (!response.ok) {
                    throw new Error(`Erreur HTTP! statut: ${response.status}`);
                }
                return response.text();
            })
                .then(html => {
                // Vérifier si la réponse contient une erreur 404
                if (html.includes('Symfony Exception') || html.includes('404 Not Found') || html.includes('object not found')) {
                    throw new Error("L'entité demandée n'existe pas. Veuillez rafraîchir la page.");
                }
                
                // Insérer les nouveaux résultats
                    eventsContainer.innerHTML = html.trim() !== "" ? html : '<p class="text-center text-muted">Aucun événement trouvé.</p>';
                
                // Mettre en place les événements de pagination sur les nouveaux liens
                setupPaginationLinks();
                
                return html; // Retourner le HTML pour permettre un traitement ultérieur si nécessaire
                })
                .catch(error => {
                console.error('Erreur de recherche:', error);
                // Afficher un message d'erreur plus explicite
                let errorMessage = 'Une erreur est survenue lors de la recherche. ';
                
                if (error.message.includes("n'existe pas")) {
                    errorMessage += "L'événement demandé n'existe plus dans la base de données.";
                } else {
                    errorMessage += "Veuillez réessayer ou recharger la page.";
                }
                
                eventsContainer.innerHTML = `
                    <div class="alert alert-danger">
                        <h5><i class="bi bi-exclamation-triangle-fill"></i> Erreur</h5>
                        <p>${errorMessage}</p>
                        <button class="btn btn-outline-danger" onclick="window.location.reload()">
                            <i class="bi bi-arrow-clockwise"></i> Recharger la page
                        </button>
                    </div>`;
                throw error; // Relancer l'erreur pour la capturer dans la chaîne d'appel
                })
                .finally(() => {
                // Masquer le spinner après chargement
                    spinner.classList.add('d-none');
                });
        }
        
        // Initialiser les écouteurs d'événements pour la pagination au chargement de la page
        document.addEventListener('DOMContentLoaded', function() {
            setupPaginationLinks();
        });
    </script>

    <script>
        document.querySelectorAll('.archive-event').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');

                Swal.fire({
                    title: 'Archiver cet événement ?',
                    text: "Toutes les inscriptions seront supprimées et un email sera envoyé aux utilisateurs.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Oui, archiver',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch("{{ path('event_archive', {'id': 'ID'}) }}".replace('ID', id), {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json'
                            }
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('Archivé !', data.message, 'success').then(() => location.reload());
                                } else {
                                    Swal.fire('Erreur !', data.message, 'error');
                                }
                            })
                            .catch(error => {
                                console.error('Erreur lors de l'archivage :', error);
                                Swal.fire('Erreur !', 'Impossible d'archiver l'événement.', 'error');
                            });
                    }
                });
            });
        });



        document.querySelectorAll('.unarchive-event').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Désarchiver cet événement ?',
                    text: "L'événement redeviendra actif.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Oui, désarchiver',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch("{{ path('event_unarchive', {'id': 'ID'}) }}".replace('ID', id), {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json'
                            }
                        })

                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('Désarchivé !', data.message, 'success').then(() => location.reload());
                                } else {
                                    Swal.fire('Erreur !', 'Les événements expirés ne peuvent pas être désarchivés.', 'error');
                                }
                            });
                    }
                });
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.delete-event').forEach(button => {
            button.addEventListener('click', function () {
                const id = this.getAttribute('data-id');
                const token = this.getAttribute('data-token'); // Récupération du CSRF token

                Swal.fire({
                    title: 'Confirmer la suppression',
                    text: 'Êtes-vous sûr de vouloir supprimer cet événement ? Cette action est irréversible.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Oui, supprimer',
                    cancelButtonText: 'Annuler'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('/event/back/delete/${id}', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: new URLSearchParams({
                                _token: token // Envoie du token récupéré depuis Twig
                            })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire(
                                        'Supprimé !',
                                        'L\'événement a été supprimé avec succès.',
                                        'success'
                                    ).then(() => location.reload()); // Recharge la page après suppression
                                } else {
                                    Swal.fire(
                                        'Erreur',
                                        data.message || 'Une erreur est survenue.',
                                        'error'
                                    );
                                }
                            })
                            .catch(error => {
                                console.error('Erreur lors de la suppression :', error);
                                Swal.fire(
                                    'Erreur',
                                    'Une erreur est survenue. Veuillez réessayer.',
                                    'error'
                                );
                            });
                    }
                });
            });
        });
    </script>

</main>
{% endblock %}