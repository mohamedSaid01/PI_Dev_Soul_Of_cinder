{% extends 'baseBackOffice.html.twig' %}
{% block title %}Créer un nouvel événement{% endblock %}
{% block body %}
  <div class="pagetitle">
    <h1>Créer un nouvel événement</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="">Accueil</a></li>
        <li class="breadcrumb-item">Événements</li>
        <li class="breadcrumb-item active">Créer</li>
      </ol>
    </nav>
  </div><!-- End Page Title -->

  <section class="section">
    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-body">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            <div class="form-group">
                            {{ form_label(form.title, 'Titre') }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.title) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.description) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.startDate, 'Date de début') }}
                            {{ form_widget(form.startDate, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.startDate) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.endDate, 'Date de fin') }}
                            {{ form_widget(form.endDate, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.endDate) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.location, 'Lieu') }}
                            {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.location) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.latitude, 'Latitude') }}
                            {{ form_widget(form.latitude, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.longitude, 'Longitude') }}
                            {{ form_widget(form.longitude, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.categorie, 'Catégorie') }}
                            {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                            <span style="color: red; font-size: 0.9em; margin-top: 0.5rem;">{{ form_errors(form.categorie) }}</span>
                        </div>
                        <div class="form-group">
                            {{ form_label(form.afficheFile, 'Affiche de l’événement') }}
                            <div class="custom-file">
                                {{ form_widget(form.afficheFile, {'attr': {'class': 'custom-file-input', 'id': 'event_afficheFile'}}) }}
                                <label class="custom-file-label" for="event_afficheFile">Choisir un fichier</label>
                            </div>
                            <span class="text-danger">{{ form_errors(form.afficheFile) }}</span>
                        </div>
                        <br>
            <button type="submit" class="btn btn-primary">Créer</button>
            {{ form_end(form) }}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}