{% extends 'baseBackOffice.html.twig' %}

{% block body %}
  <main id="main" class="main">
    <div class="pagetitle mb-4">
      <h1 class="page-title"><i class="bi bi-pencil-square"></i> Gestion des Posts</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
          <li class="breadcrumb-item">Posts</li>
          <li class="breadcrumb-item active">Liste</li>
        </ol>
      </nav>
    </div>
    <div class="container-fluid mt-5">
      <div class="card shadow-lg border-0 rounded-4" style="background: #fff; box-shadow: 0 4px 24px rgba(0,0,0,0.08); border-radius: 24px;">
            <div class="card-body p-4">
              <h2 class="text-center text-primary fw-bold mb-4">📝 Post Management</h2>
          
              <!-- Combined Filter and Sorting Section -->
              <div class="d-flex justify-content-between align-items-center mb-4">
                  <!-- Total Posts Count -->
                  <span class="text-muted fs-5">Total Posts: <strong>{{ posts|length }}</strong></span>
          
                  <!-- Combined Filter and Sorting Form -->
                  <form method="get" action="{{ path('post_index') }}" class="d-flex align-items-center">
                      <!-- Filter by Category -->
                      <select name="category" class="form-select me-2">
                          <option value="">All Categories</option>
                          {% for category in categories %}
                              <option value="{{ category.id }}" {{ selectedCategory == category.id ? 'selected' : '' }}>
                                  {{ category.name }}
                              </option>
                          {% endfor %}
                      </select>
          
                      <!-- Filter by Type -->
                      <select name="type" class="form-select me-2">
                          <option value="">All Types</option>
                          {% for type in types %}
                              <option value="{{ type }}" {{ selectedType == type ? 'selected' : '' }}>
                                  {{ type }}
                              </option>
                          {% endfor %}
                      </select>
          
                      <!-- Sorting Dropdown -->
                      <select name="sort" class="form-select me-2">
                          <option value="newest" {{ selectedSort == 'newest' ? 'selected' : '' }}>Newest First</option>
                          <option value="oldest" {{ selectedSort == 'oldest' ? 'selected' : '' }}>Oldest First</option>
                          <option value="most_comments" {{ selectedSort == 'most_comments' ? 'selected' : '' }}>Most Comments</option>
                          <option value="fewest_comments" {{ selectedSort == 'fewest_comments' ? 'selected' : '' }}>Fewest Comments</option>
                      </select>
          
                      <!-- Submit Button -->
                      <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-1 px-3 py-2 rounded-3 shadow-sm">
                        <i class="bi bi-funnel"></i> Apply
                      </button>
          
                      <!-- Reset Button -->
                      <a href="{{ path('post_index') }}" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 px-3 py-2 rounded-3 shadow-sm ms-2">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                      </a>
                  </form>
              </div>

              <!-- Table -->
              <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered text-center align-middle table-posts">
                  <thead>
                    <tr>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold; border-top-left-radius: 12px;"><i class="bi bi-card-text"></i> Title</th>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold;"><i class="bi bi-tag"></i> Type</th>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold;"><i class="bi bi-calendar"></i> Created At</th>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold;"><i class="bi bi-person"></i> Author</th>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold;"><i class="bi bi-toggle-on"></i> Enable</th>
                      <th style="background: #dbeafe !important; color: #222 !important; font-weight: bold; border-top-right-radius: 12px;"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for post in posts %}
                      <tr class="table-row">
                        <td>{{ post.title }}</td>
                        <td>{{ post.type }}</td>
                        <td>{{ post.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td>{{ post.author.firstName }} {{ post.author.lastName }}</td>
                        <td>
                            <form action="{{ path('post_toggle_enable', {'id': post.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ post.id) }}">
                                <button type="submit" class="btn {{ post.enabled ? 'btn-success' : 'btn-danger' }}">
                                    {{ post.enabled ? 'Enabled' : 'Disabled' }}
                                </button>
                            </form>
                        </td>
                        <td>
                          <div class="d-flex gap-1 justify-content-center">
                            <button class="btn btn-info btn-sm" onclick="showDetails({{ post.id }})" title="Voir"><i class="bi bi-eye"></i></button>
                            <form class="delete-form" action="{{ path('post_delete', {'id': post.id}) }}" method="post">
                              <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                              <button type="button" class="btn btn-danger btn-sm delete-btn" title="Supprimer"><i class="bi bi-trash"></i></button>
                            </form>
                            <button class="btn btn-warning btn-sm" onclick="showComments({{ post.id }})" title="Commentaires"><i class="bi bi-chat-dots"></i></button>
                          </div>
                        </td>
                      </tr>

                      <!-- Hidden Modal for Viewing Details -->
                      <tr id="details-{{ post.id }}" class="details-row" style="display: none;">
                        <td colspan="6">
                          <div class="card p-3">
                            <h5>Description:</h5>
                            <p>{{ post.description }}</p>
                            <h5>Image:</h5>
                            {% if post.image %}
                                <img src="{{ asset('uploads/' ~ post.image) }}" alt="Post Image" class="img-fluid rounded shadow-sm" style="max-width: 200px;">
                            {% else %}
                                <p class="text-muted">Non spécifié</p>
                            {% endif %}
                          </div>
                        </td>
                      </tr>

                      <!-- Hidden Row for Comments -->
                      <tr id="comments-{{ post.id }}" class="comments-row" style="display: none;">
                        <td colspan="6">
                          <div class="card p-3">
                            <h5>Comments:</h5>
                            {% if post.comments|length > 0 %}
                              <ul class="list-group">
                                {% for comment in post.comments %}
                                  <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                      <strong>{{ post.author.firstName }} {{ post.author.lastName }}:</strong> {{ comment.content }}
                                      <small class="text-muted">{{ comment.createdAt|date('Y-m-d H:i:s') }}</small>
                                    </div>
                                    <!-- Delete Form -->
                                    <form action="{{ path('comment_delete', { id: comment.id }) }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                      <input type="hidden" name="_method" value="DELETE">
                                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                      <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Delete
                                      </button>
                                    </form>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% else %}
                              <p class="text-muted">No comments found.</p>
                            {% endif %}
                          </div>
                        </td>
                      </tr>

                    {% else %}
                      <tr>
                        <td colspan="6" class="text-muted py-4">
                          <i class="fas fa-exclamation-circle fa-2x mb-3"></i><br>
                          No posts found.
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    // Function to show/hide details
    function showDetails(postId) {
      var detailsRow = document.getElementById('details-' + postId);
      if (detailsRow.style.display === "none" || !detailsRow.style.display) {
        detailsRow.style.display = "table-row"; // Show the details row
      } else {
        detailsRow.style.display = "none"; // Hide the details row
      }
    }

    function showComments(postId) {
      var commentsRow = document.getElementById('comments-' + postId);
      if (commentsRow.style.display === "none" || !commentsRow.style.display) {
        commentsRow.style.display = "table-row"; // Show the comments row
      } else {
        commentsRow.style.display = "none"; // Hide the comments row
      }
    }

    // Function to handle post deletion
   document.querySelectorAll('.delete-btn').forEach(button => {
    button.addEventListener('click', function () {
        const form = this.closest('.delete-form'); // Récupérer le formulaire parent
        const actionUrl = form.getAttribute('action'); // Récupérer l'URL de l'action
        const csrfToken = form.querySelector('input[name="_token"]').value; // Récupérer le token CSRF

        Swal.fire({
            title: 'Confirm Deletion',
            text: 'Are you sure you want to delete this post? This action is irreversible.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(actionUrl, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ _token: csrfToken }) // Envoyer le token CSRF
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok.');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        Swal.fire('Deleted!', data.message, 'success')
                            .then(() => location.reload()); // Recharger la page en cas de succès
                    } else {
                        Swal.fire('Error', data.message, 'error'); // Afficher un message d'erreur
                    }
                })
                .catch(error => {
                    console.error('Error during deletion:', error);
                    Swal.fire('Error', 'An error occurred. Please try again.', 'error');
                });
            }
        });
    });
});
  </script>
  <style>
    /* Main Content */
    .main-content {
      margin-left: 300px;
      padding: 20px;
    }

    /* Table Responsiveness */
    .table-responsive {
      overflow-x: auto;
      max-width: 100%;
    }

    .table {
      width: 100%;
      table-layout: auto;
    }

    .table th, .table td {
      white-space: nowrap; /* Prevents text from wrapping */
    }

    /* Hover Effect */
    .table-row:hover {
      background-color: #f8f9fa !important;
      transition: background-color 0.3s ease;
    }

    /* Buttons */
    .btn {
      transition: transform 0.2s ease;
    }

    .btn:hover {
      transform: scale(1.05);
    }

    .d-flex.gap-2 {
      gap: 0.5rem;
    }

    /* Enable/Disable Badge */
    .badge {
      font-size: 0.9rem;
      padding: 5px 10px;
      border-radius: 5px;
    }

    /* Details Row Styling */
    .details-row {
      background-color: #f8f9fa;
    }

    /* Alternating Row Colors */
    .table-striped tbody tr:nth-of-type(odd) {
      background-color: #f8f9fa;
    }

    .table-striped tbody tr:nth-of-type(even) {
      background-color: #ffffff;
    }

    /* Image Styling */
    .details-row img {
      max-width: 100%;
      height: auto;
      display: block;
      margin: auto;
      border-radius: 5px;
    }

    /* Responsive Design */
    @media (max-width: 992px) {
      .main-content {
        margin-left: 0; /* Removes fixed margin */
        padding: 10px;
      }

      .d-flex.justify-content-between {
        flex-direction: column;
        text-align: center;
      }

      .btn {
        width: 100%;
        margin-top: 5px;
      }
    }

    @media (max-width: 768px) {
      .table th, .table td {
        font-size: 14px;
        padding: 10px;
      }

      .table-responsive {
        overflow-x: auto;
      }

      .btn {
        font-size: 14px;
        padding: 8px;
      }

      .details-row .card {
        text-align: center;
      }
    }

    @media (max-width: 576px) {
      .btn {
        font-size: 12px;
        padding: 6px;
      }

      .table th, .table td {
        font-size: 12px;
        padding: 8px;
      }
    }

    /* Style spécifique pour l'en-tête du tableau des posts */
    .table-posts thead, .table-posts thead tr, .table-posts thead th {
      background: #dbeafe !important;
      color: #222 !important;
      font-weight: bold !important;
      border-top: none !important;
    }
    .table-posts thead th:first-child {
      border-top-left-radius: 12px !important;
    }
    .table-posts thead th:last-child {
      border-top-right-radius: 12px !important;
    }
  </style>
{% endblock %}