{# templates/admin/user_list.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}List of Unverified Users - SAHATECK{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table th {
            color: rgb(31, 31, 34);
            font-weight: 600;
            font-size: 15px;
        }

        .table td {
            font-weight: 400;
            font-size: 13px;
            color: #333;
        }

        .table {
            font-family: 'Poppins', sans-serif;
        }

        p {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
        }

        .btn-add {
            margin-bottom: 15px;
            background-color: #00B4D8;
            color: white;
            border: none;
            font-weight: 500;
            padding: 10px 20px;
            display: inline-block;
            text-align: center;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-add:hover {
            background-color: #90E0E6;
        }

        .search-bar {
            margin-bottom: 15px;
            width: 400px;
            position: relative;
        }

        .search-bar input {
            padding-left: 30px;
            padding-right: 30px;
            width: 100%;
        }

        .search-bar .bi-search {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .search-bar input::placeholder {
            font-family: 'Poppins', sans-serif;
            font-weight: 200;
            font-size: 13px;
            color: #6c757d;
        }

        .search-bar button {
            background-color: white;
            color: black;
            border-color: black;
            font-weight: 350;
            border-radius: 5px;
            cursor: pointer;
            height: 38px;
        }

        .search-bar button:hover {
            background-color: #90E0E6;
            border-color: #90E0E6;
        }

        /* Styles for pagination */
        .navigation {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        .pagination {
            display: flex;
            list-style: none;
            padding: 0;
            margin: 0;
            gap: 8px; /* Space between elements */
        }

        .pagination span,
        .pagination a {
            display: block;
            padding: 5px 7px;
            border: 1px solid #ddd;
            border-radius: 5px;
            color: #00B4D8;
            text-decoration: none;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            transition: background-color 0.3s, color 0.3s;
        }

        .pagination a:hover {
            background-color: #00B4D8;
            color: white;
            border-color: #00B4D8;
        }

        .pagination .current {
            background-color: #00B4D8;
            color: white;
            border-color: #00B4D8;
        }

        .pagination .disabled {
            color: #ddd;
            border-color: #ddd;
            cursor: not-allowed;
        }

        .pagination .next a,
        .pagination .last a {
            font-weight: bold;
        }
    </style>
{% endblock %}

{% block body %}
  <main id="main" class="main">
    <section class="section">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">List of Unaccepted Doctors</h5>
              <p>Find here the list of unaccepted doctors. You can view their information and verify them if necessary.</p>

              <!-- Table of Unverified Users -->
              <div class="container-fluid mt-4">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Last Name</th>
                                <th>First Name</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Phone Number</th>
                                <th>Specialty</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.lastName ? user.lastName : 'Not specified' }}</td>
                                    <td>{{ user.firstName ? user.firstName : 'Not specified' }}</td>
                                    <td>{{ user.email ? user.email : 'Not specified' }}</td>
                                    <td>{{ user.adress ? user.adress : 'Not specified' }}</td>
                                    <td>{{ user.phoneNumber ? user.phoneNumber : 'Not specified' }}</td>
                                    <td>
                                        {% if user.specialite is defined and user.specialite is not null %}
                                            {{ user.specialite.value }}
                                        {% else %}
                                            Not specified
                                        {% endif %}
                                    </td>
                                    <td>
                                        <!-- View Button -->
                                        <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-info btn-sm" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <!-- Verify Button -->
                                        <a href="{{ path('admin_verify_user', {'id': user.id}) }}" class="btn btn-success btn-sm verify-btn" title="Accept">
                                            <i class="bi bi-check-circle"></i>
                                        </a>
                                        <!-- Delete Button -->
                                        <form method="post" action="{{ path('admin_delete_user', {'id': user.id}) }}" class="d-inline delete-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">No unverified users found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
              </div>
              <div class="mt-4">
                <a href="{{ path('app_medecins_list') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Handler for the "Verify" button
            document.querySelectorAll('.verify-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault(); // Prevents default behavior (redirection)

                    Swal.fire({
                        text: "Are you sure you want to verify this user?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#28a745', // Green for "Confirm"
                        cancelButtonColor: '#d33', // Red for "Cancel"
                        confirmButtonText: 'Yes, verify!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Redirect to the button's URL if confirmed
                            window.location.href = this.href;
                        }
                    });
                });
            });

            // Handler for the "Delete" button
            document.querySelectorAll('.delete-form').forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault(); // Prevents default behavior (form submission)

                    Swal.fire({
                        text: "Are you sure you want to delete this doctor?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33', // Red for "Delete"
                        cancelButtonColor: '#6c757d', // Gray for "Cancel"
                        confirmButtonText: 'Yes, delete!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Submit the form if confirmed
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}