{% extends 'baseFrontOffice.html.twig' %}

{% block title %}Liste des Posts{% endblock %}

{% block body %}
<div class="content-container">
    <h2 class="page-title">Liste des Posts</h2>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- Combined Filter and Sorting Form -->
        <form method="get" action="{{ path('app_front_list') }}" class="d-flex align-items-center">
            <!-- Filter by Category -->
            <select name="category" class="form-select me-2">
                <option value="">All Categories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ selectedCategory == category.id ? 'selected' : '' }}>
                        {{ category.name }}
                    </option>
                {% endfor %}
            </select>
        
            <!-- Filter by Type -->
            <select name="type" class="form-select me-2">
                <option value="">All Types</option>
                {% for type in types %}
                    <option value="{{ type }}" {{ selectedType == type ? 'selected' : '' }}>
                        {{ type }}
                    </option>
                {% endfor %}
            </select>
        
            <!-- Sorting Dropdown -->
            <select name="sortBy" class="form-select me-2">
                <option value="newest" {{ sortBy == 'newest' ? 'selected' : '' }}>Newest First</option>
                <option value="oldest" {{ sortBy == 'oldest' ? 'selected' : '' }}>Oldest First</option>
                <option value="most_comments" {{ sortBy == 'most_comments' ? 'selected' : '' }}>Most Comments</option>
                <option value="least_comments" {{ sortBy == 'least_comments' ? 'selected' : '' }}>Least Comments</option>
            </select>
        
            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-funnel me-1"></i>Filtrer
            </button>
        
            <!-- Reset Button -->
            <a href="{{ path('app_front_list') }}" class="btn btn-outline-secondary btn-sm ms-2">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser
            </a>
        </form>
        
        <!-- Create post -->
        {% if app.user is not null %}
            <a href="{{ path('front_create') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i>Créer un nouveau post
            </a>
        {% endif %}
    </div>

    <div class="row">
        {% for post in pagination %}
            <div class="col-md-4 mb-4">
                <div class="card card-fixed-size">
                    {% if post.image %}
                        <div class="position-relative">
                            <img src="{{ asset('uploads/' ~ post.image) }}" alt="Post Image" class="card-img-fixed-height">
                        </div>
                    {% else %}
                        <div class="card-img-fixed-height bg-light d-flex align-items-center justify-content-center">
                            <i class="bi bi-file-text fs-1 text-muted"></i>
                        </div>
                    {% endif %}
                    
                    <div class="card-body card-body-fixed-height">
                        <!-- Menu for Edit/Delete (Only for Admin/Author) -->
                        {% if app.user and app.user.id == post.author.id %}
                            <div class="dropdown position-absolute" style="top: 10px; right: 10px; z-index: 1;">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton-{{ post.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton-{{ post.id }}">
                                    <li><a class="dropdown-item" href="{{ path('front_edit', { id: post.id }) }}">Modifier</a></li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="event.preventDefault(); if (confirm('Are you sure you want to delete this post?')) { document.getElementById('delete-post-{{ post.id }}').submit(); }">
                                            Supprimer
                                        </a>
                                        <form id="delete-post-{{ post.id }}" method="post" action="{{ path('front_delete', {'id': post.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% endif %}
        
                        <h5 class="card-title fw-bold">{{ post.title }}</h5>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="badge bg-primary-custom">{{ post.type }}</span>
                            <span class="badge bg-secondary">{{ post.category.name }}</span>
                        </div>
                        
                        <p class="card-text-truncate mb-2">{{ post.description|slice(0, 80) }}...</p>
                        
                        <p class="mb-0"><small class="text-muted">Par: {{ post.author.firstName }} {{ post.author.lastName }}</small></p>
                        <p class="mb-0"><small class="text-muted">{{ post.formattedDate }}</small></p>
                    </div>
                    
                    <div class="card-footer bg-white border-top-0">
                        <a href="{{ path('app_front_post_show', { id: post.id, page: pagination.currentPageNumber, category: selectedCategory, type: selectedType, sortBy: sortBy}) }}" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-chat-dots me-1"></i>Commentaires 
                            <span class="badge bg-light text-dark">{{ post.comments|length }}</span>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">Aucun post trouvé.</div>
            </div>
        {% endfor %}
    </div>
    
    <!-- Pagination Navigation -->
    <div class="pagination">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}