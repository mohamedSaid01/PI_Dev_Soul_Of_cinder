{% extends 'baseFrontOffice.html.twig' %}

{% block title %}SAHATECH - {{ event.title }}{% endblock %}

{% block body %}
<!-- Intégration des styles Leaflet -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<style>
    /* Conteneur principal */
    .event-container {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    /* Section des détails */
    .event-details {
        flex: 1;
        max-width: 45%;
        margin-right: 20px;
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 10px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }

    .event-details h1 {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .event-details p {
        font-size: 1.2rem;
        color: #555;
        margin-bottom: 15px;
    }

    .event-details .btn {
        margin-top: 15px;
    }

    /* Conteneur de la carte */
    #event-map {
        flex: 1;
        max-width: 45%;
        height: 300px;
        border-radius: 10px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<section class="event-page">
    <!-- Bannière avec l'affiche -->
    <div class="event-banner">
        <img src="{{ asset('uploads/affiches/' ~ event.affiche) }}" alt="Affiche de {{ event.title }}" style="max-height: 400px; width: 100%; object-fit: contain;">
    </div>

    <!-- Conteneur principal -->
    <div class="container event-container">
        <!-- Détails de l'événement -->
        <div class="event-details">
            <h1>{{ event.title }}</h1>
            <p><strong>Date de début :</strong> {{ event.startDate|date('d/m/Y H:i') }}</p>
            <p><strong>Date de fin :</strong> {{ event.endDate|date('d/m/Y H:i') }}</p>
            <p><strong>Lieu :</strong> {{ event.location }}</p>
            <p>{{ event.description }}</p>
            <a href="contact.html" class="btn btn-medium btn-primary btn-pill text-uppercase">Contact us</a>
        </div>

        <!-- Carte Leaflet -->
        <div id="event-map"></div>
    </div>
</section>

<!-- Intégration de Leaflet.js -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script>
    // Initialisation de la carte
    const eventLatitude = {{ event.latitude|default(0) }}; // Latitude de l'événement
    const eventLongitude = {{ event.longitude|default(0) }}; // Longitude de l'événement
    const eventLocation = "{{ event.location }}"; // Lieu de l'événement

    const map = L.map('event-map').setView([eventLatitude, eventLongitude], 13); // Vue initiale de la carte

    // Chargement de la couche de tuiles (OpenStreetMap)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Ajout d'un marqueur
    L.marker([eventLatitude, eventLongitude]).addTo(map)
        .bindPopup(`<strong>${eventLocation}</strong>`)
        .openPopup();
</script>

{% endblock %}
