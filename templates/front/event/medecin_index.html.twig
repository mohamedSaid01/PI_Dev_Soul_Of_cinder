{% extends 'baseFrontOffice.html.twig' %}

{% block title %}SAHATECH - {{ 'Événements'|trans }}{% endblock %}

{% block body %}
    <style>
        .event-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border-radius: 10px;
        }

        .card {
            border: 1px solid #ddd;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 10px;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
        }

        .event-details {
            font-size: 14px;
            color: #555;
        }

        .event-category {
            background-color: #007bff;
            color: white;
            font-size: 14px;
            padding: 5px 10px;
            border-radius: 5px 5px 0 0;
            text-align: center;
            font-weight: bold;
        }

        .event-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 5px 10px;
            border-radius: 5px;
            font-weight: bold;
        }

        .badge-active {
            background-color: #28a745; /* Vert pour les événements actifs */
            color: white;
        }

        .badge-archived {
            background-color: #dc3545; /* Rouge pour les événements expirés */
            color: white;
        }
    </style>

    <section class="container mt-4">
        <h2 class="text-center fw-bold text-primary">Nos Événements</h2>

        <!-- 🚀 Section des Événements Actifs -->
        <h3 class="mt-4 text-success">Événements en cours</h3>
        <div class="row mt-4">
            {% for event in events_active %}
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="event-category">{{ event.categorie.nom }}</div> {# 🔥 Ajout de la catégorie ici #}
                        <div class="position-relative">
                            <span class="event-badge badge-active">Actif</span>
                            <img src="{{ event.affiche ? asset('uploads/affiches/' ~ event.affiche) : asset('images/default-event.png') }}"
                                 class="event-image" alt="Affiche de {{ event.title }}">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{ event.title }}</h5>
                            <p class="event-details">
                                <i class="bi bi-geo-alt"></i> Lieu: <strong>{{ event.location }}</strong><br>
                                <i class="bi bi-calendar"></i> Date: {{ event.startDate|date('d M Y') }} - {{ event.endDate|date('d M Y') }}<br>
                                <i class="bi bi-people"></i> Places disponibles: <strong>{{ event.placesDisponibles }}</strong>
                            </p>
                            <p>{{ event.description|slice(0, 100) }}...</p>
                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}" class="btn btn-success">Détails</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-center">Aucun événement actif disponible.</p>
            {% endfor %}
        </div>

        <!-- 🔥 Section des Événements Expirés -->
        <h3 class="mt-5 text-danger">Événements expirés</h3>
        <div class="row mt-4">
            {% for event in events_archived %}
                {% if event.isExpired %}

                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="event-category">{{ event.categorie.nom }}</div> {# 🔥 Ajout de la catégorie ici #}
                        <div class="position-relative">
                            <span class="event-badge badge-archived">Expiré</span>
                            <img src="{{ event.affiche ? asset('uploads/affiches/' ~ event.affiche) : asset('images/default-event.png') }}"
                                 class="event-image" alt="Affiche de {{ event.title }}">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{ event.title }}</h5>
                            <p class="event-details">
                                <i class="bi bi-geo-alt"></i> Lieu: <strong>{{ event.location }}</strong><br>
                                <i class="bi bi-calendar"></i> Date: {{ event.startDate|date('d M Y') }} - {{ event.endDate|date('d M Y') }}<br>
                                <i class="bi bi-people"></i> Places disponibles: <strong>{{ event.placesDisponibles }}</strong>
                            </p>
                            <p>{{ event.description|slice(0, 100) }}...</p>
                            <a href="{{ path('front_medecin_event_show', {'id': event.id}) }}" class="btn btn-danger">Voir détails</a>
                        </div>
                    </div>
                </div>
                {% endif %}
            {% else %}
                <p class="text-center">Aucun événement expiré disponible.</p>

            {% endfor %}
        </div>

        <div id="map" style="height: 500px; width: 100%; margin-top: 20px;"></div>

    </section>

    <!-- Script pour Leaflet.js (Aucune modification sur la carte, comme demandé) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var map = L.map('map').setView([36.8065, 10.1815], 10);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var events = [
                {% for event in events_active %}
                {% if event.latitude and event.longitude %}
                { lat: {{ event.latitude }}, lng: {{ event.longitude }}, title: "{{ event.title }}", status: "Actif" },
                {% endif %}
                {% endfor %}
                {% for event in events_archived %}
                {% if event.latitude and event.longitude %}
                { lat: {{ event.latitude }}, lng: {{ event.longitude }}, title: "{{ event.title }}", status: "Expiré" },
                {% endif %}
                {% endfor %}
            ];

            events.forEach(event => {
                var markerColor = event.status === "Actif" ? "green" : "red";
                L.marker([event.lat, event.lng], {
                    icon: L.divIcon({
                        className: `custom-marker-${markerColor}`,
                        html: `<div style="background-color:${markerColor}; width:12px; height:12px; border-radius:50%;"></div>`
                    })
                }).addTo(map).bindPopup(`<strong>${event.title}</strong><br>Status: ${event.status}`);
            });
        });
    </script>

    <!-- Leaflet CSS et JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

{% endblock %}
