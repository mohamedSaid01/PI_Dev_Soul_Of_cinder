{# templates/registration/medecin_register.html.twig #}

{% extends 'baseBackOffice.html.twig' %}

{% block title %}Inscription Médecin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .form-col {
            flex: 1;
            min-width: 250px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #00B4D8;
            box-shadow: 0 0 5px rgba(0, 180, 216, 0.5);
        }

        .btn-primary {
            background-color: #00B4D8;
            border-color: #00B4D8;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 8px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0096C7;
            border-color: #0096C7;
        }

        .text-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
            font-family: 'Poppins', sans-serif;
        }

        p {
            font-family: 'Poppins', sans-serif;
            font-weight: 200; /* Poids de la police (medium) */
            font-size: 13px;
        }
    </style>
{% endblock %}

{% block body %}
    <main id="main" class="main">
        <div class="card">
            <div class="card-body">
                <div class="form-container">
                    <h5 class="card-title">Ajouter un nouveau médecin</h5>
                    <p>Utilisez ce formulaire pour ajouter un nouveau médecin à notre application.<br>Assurez-vous de remplir tous les champs requis pour enregistrer correctement le médecin.</p>

                    {{ form_errors(medecinRegistrationForm) }}

                    {{ form_start(medecinRegistrationForm, {'attr': {'class': 'form', novalidate: 'novalidate'}}) }}
                        <div class="form-row">
                            <!-- Colonne de gauche -->
                            <div class="form-col">
                                <div class="form-group">
                                    <label>Prénom</label>
                                    {{ form_widget(medecinRegistrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le prénom du médecin'}}) }}
                                    {{ form_errors(medecinRegistrationForm.firstName) }}
                                </div>
                                <div class="form-group">
                                    <label>Email</label>
                                    {{ form_widget(medecinRegistrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Entrez l\'email du médecin'}}) }}
                                    {{ form_errors(medecinRegistrationForm.email) }}
                                </div>
                                <div class="form-group">
                                    <label>Adresse</label>
                                    {{ form_widget(medecinRegistrationForm.adress, {'attr': {'class': 'form-control', 'placeholder': 'Entrez l\'adresse du médecin'}}) }}
                                    {{ form_errors(medecinRegistrationForm.adress) }}
                                </div>
                                <div class="form-group">
                                    <label>Numéro de Licence</label>
                                    {{ form_widget(medecinRegistrationForm.numeroLicence, {'attr': {'class': 'form-control', 'placeholder': 'Format : ABC12345 (3 lettres suivies de 5 chiffres)'}}) }}
                                    {{ form_errors(medecinRegistrationForm.numeroLicence) }}
                                </div>
                            </div>

                            <!-- Colonne de droite -->
                            <div class="form-col">
                                <div class="form-group">
                                    <label>Nom</label>
                                    {{ form_widget(medecinRegistrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le nom du médecin'}}) }}
                                    {{ form_errors(medecinRegistrationForm.lastName) }}
                                </div>
                                <div class="form-group">
                                    <label>Téléphone</label>
                                    {{ form_widget(medecinRegistrationForm.phoneNumber, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le numéro de téléphone'}}) }}
                                    {{ form_errors(medecinRegistrationForm.phoneNumber) }}
                                </div>
                                <div class="form-group">
                                    <label>Genre</label>
                                    {{ form_widget(medecinRegistrationForm.gender, {'attr': {'class': 'form-control', 'placeholder': 'Sélectionnez le genre'}}) }}
                                    {{ form_errors(medecinRegistrationForm.gender) }}
                                </div>
                                <div class="form-group">
                                    <label>Spécialité</label>
                                    {{ form_widget(medecinRegistrationForm.specialite, {'attr': {'class': 'form-control', 'placeholder': 'Sélectionnez la spécialité'}}) }}
                                    {{ form_errors(medecinRegistrationForm.specialite) }}
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Ajouter médecin</button>
                        </div>
                    {{ form_end(medecinRegistrationForm) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}