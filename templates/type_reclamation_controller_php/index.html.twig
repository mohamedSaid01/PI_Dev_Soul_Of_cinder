{% extends 'baseBackOffice.html.twig' %}

{% block title %}Gestion des Types de Réclamation{% endblock %}

{% block body %}
  <main id="main" class="main">
  <div class="pagetitle mb-4">
    <h1 class="page-title"><i class="bi bi-flag"></i> Gestion des Types de Réclamation</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
        <li class="breadcrumb-item">Réclamations</li>
        <li class="breadcrumb-item active">Types</li>
      </ol>
    </nav>
  </div>
  <div class="row g-4">
    <div class="col-12">
      <div class="card glass-card p-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="card-title mb-0"><i class="bi bi-list-task"></i> Liste des Types de Réclamation</h3>
            <a href="{{ path('app_type_reclamation_controller_php_new') }}" class="btn btn-success">
              <i class="bi bi-plus-circle"></i> Ajouter un type
            </a>
          </div>
          <div class="table-responsive">
            <table class="table table-hover table-bordered shadow-sm">
              <thead style="background: #dbeafe; color: #222; font-weight: bold; border-top-left-radius: 12px; border-top-right-radius: 12px;">
        <tr>
                  <th style="border-top-left-radius: 12px;">Type de réclamation</th>
                  <th style="border-top-right-radius: 12px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for type_reclamation in type_reclamations %}
          <tr>
            <td>{{ type_reclamation.typeReclamation }}</td>
                    <td>
                      <a href="{{ path('app_type_reclamation_controller_php_show', {'id': type_reclamation.id}) }}" class="btn btn-info btn-sm"><i class="bi bi-eye"></i></a>
                      <a href="{{ path('app_type_reclamation_controller_php_edit', {'id': type_reclamation.id}) }}" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
            </td>
          </tr>
        {% else %}
                  <tr><td colspan="2" class="text-center">Aucun type trouvé.</td></tr>
        {% endfor %}
      </tbody>
    </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  </main>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
<style>
    .table tbody tr { background-color: #f3f8ff !important; transition: background-color 0.3s ease; }
    .table tbody tr:hover { background-color: #e0e7ef !important; }
    .btn-info, .btn-warning, .btn-success { transition: all 0.3s ease; }
    .btn-info:hover { background-color: #17a2b8; border-color: #17a2b8; }
    .btn-warning:hover { background-color: #e0a800; border-color: #e0a800; }
    .btn-success:hover { background-color: #218838; border-color: #218838; }
</style>
{% endblock %}