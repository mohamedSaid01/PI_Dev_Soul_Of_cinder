{% extends 'baseBackOffice.html.twig' %}

{% block title %}Rejoindre la Consultation{% endblock %}

{% block body %}
<main id="main" class="main">
    

    <div class="container mt-5">
        <div class="row justify-content-center">

            <div class="mb-4">
                <p>
                    <strong>Patient(e) :</strong> {{ rendezVous.patient.user.firstName|e }} {{ rendezVous.patient.user.lastName|e }}
                </p>
            
                <p>
                    <strong>Date du rendez-vous :</strong> {{ rendezVous.date|date('d/m/Y') }} à {{ rendezVous.heure|date('H:i') }}
                </p>
            </div>
            <div class="col-lg-8 col-md-10">
                <h1 class="text-center mb-4 text-primary">🔗 Rejoindre la Consultation</h1>

                <div class="card shadow-sm p-4 bg-white">
                    <div class="card-body text-center">
                        <h3 class="card-title mb-4">Lien de la Consultation</h3>

                        <!-- Afficher le lien Jitsi Meet -->
                        {% if rendezVous.lienJitsi %}
                            <p>
                                Cliquez sur le bouton ci-dessous pour rejoindre la consultation :
                            </p>
                            <a href="{{ rendezVous.lienJitsi|e }}" 
                               target="_blank" 
                               class="btn btn-primary btn-lg">
                                 Rejoindre la consultation
                            </a>
                        {% else %}
                            <p class="text-muted">Le lien de la consultation n'est pas disponible.</p>
                        {% endif %}
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a href="{{ path('medecin_rendez_vous_acceptes') }}" class="btn btn-outline-secondary btn-lg">
                       Retour aux rendez-vous acceptés
                    </a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .card {
            border-radius: 10px;
            overflow: hidden;
        }
        .card-title {
            font-size: 24px;
            font-weight: bold;
        }
        .btn {
            padding: 10px 20px;
            font-size: 16px;
        }
        p {
            font-size: 18px;
            margin-bottom: 10px;
        }
    </style>


    <script src="https://meet.jit.si/external_api.js"></script>
    <script>
        // Récupérer les informations du patient (invité) depuis Twig
        const patientName = "{{ rendezVous.patient.user.firstName }} {{ rendezVous.patient.user.lastName }}";
        const patientEmail = "{{ rendezVous.patient.user.email }}";

        // Options de configuration de Jitsi Meet
        const domain = 'meet.jit.si';
        const options = {
            roomName: '{{ rendezVous.lienJitsi }}', // Nom de la salle de réunion
            width: '100%',
            height: 500,
            parentNode: document.querySelector('#jitsi-container'),
            userInfo: {
                displayName: patientName, // Nom du patient
                email: patientEmail, // Email du patient
            },
            configOverwrite: {
                startWithAudioMuted: true, // Microphone désactivé par défaut
                startWithVideoMuted: true, // Caméra désactivée par défaut
                prejoinPageEnabled: false, // Désactiver la page de pré-join
            },
            interfaceConfigOverwrite: {
                SHOW_JITSI_WATERMARK: false, // Masquer le logo Jitsi
                SHOW_WATERMARK_FOR_GUESTS: false, // Masquer le logo pour les invités
            },
        };

        // Initialiser Jitsi Meet
        const api = new JitsiMeetExternalAPI(domain, options);
    </script>
</main>
{% endblock %}