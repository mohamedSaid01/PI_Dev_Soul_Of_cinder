{% extends 'baseFrontOffice.html.twig' %}

{% block title %}{{ produit.name }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    /* General Styling */
    .product-details {
      margin-top: 40px;
    }
    
    .product-image {
      max-width: 100%;
      height: auto;
      border-radius: 15px;
      border: 4px solid #343a40; /* Thicker border */
      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
    }

    /* Text Styling */
    h1, h4, h3 {
      font-weight: 800;
      color: #212529;
    }

      .qr-code {
      width: 20%; /* Smaller size */
      height: 50%;
      border: 2px solid #343a40;
      border-radius: 10px;
      padding: 5px;
    }

    .text-muted {
      font-weight: 600;
      font-size: 1.1rem;
    }

    /* Buttons */
    .btn {
      font-weight: bold;
      padding: 10px 15px;
      border-radius: 8px;
    }

    .btn-success {
      background-color: #198754;
      border: 2px solid #145c39;
    }

    .btn-outline-danger {
      border: 2px solid #dc3545;
    }

    /* Related Products */
    .related-products {
      margin-top: 50px;
    }

    .related-product-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border-radius: 12px;
      border: 3px solid #343a40; /* Thicker border */
      font-weight: bold;
    }

    .related-product-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.25);
    }

    /* Comments */
    .comment-section {
      max-height: 250px;
      overflow-y: auto;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 12px;
      border: 3px solid #dee2e6;
    }

    .comment-card {
      padding: 12px;
      background: white;
      border-radius: 10px;
      font-weight: 600;
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
      border: 2px solid #adb5bd;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="container product-details">
    <div class="row">
      <div class="col-md-6">
        <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="product-image" alt="{{ produit.name }}">
      </div>
      <div class="col-md-6">
        <h1 class="fw-bold">{{ produit.name }}</h1>
        <p class="text-muted">{{ produit.desciption }}</p>
        <p><strong>Price:</strong> {{ produit.price }} Dt</p>
        <p><strong>Stock:</strong> {{ produit.quantity }} available</p>

       

        {% if app.user %}
          <form action="{{ path('add_to_cart', {'id': produit.id}) }}" method="POST" class="mt-3">
            <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart' ~ produit.id) }}">
            <button type="submit" class="btn btn-success">🛒 Add To Cart</button>
          </form>

          <form action="{{ path('toggle_favorite', {'id': produit.id}) }}" method="POST" class="mt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_favorite' ~ produit.id) }}">
            <button type="submit" class="btn btn-outline-danger">
              {% if produit in app.user.favoris|map(f => f.produit) %}❤️ Remove from Favorites{% else %}🤍 Add to Favorites{% endif %}
            </button>
          </form>
        {% endif %}
      </div>
    </div>

    <div class="mt-5">
      <h4>Comments</h4>
      <div class="comment-section">
        {% for commentaire in produit.commentaires %}
          <div class="comment-card mb-2">
            <p>{{ commentaire.content }}</p>
            <small class="text-muted">By {{ commentaire.user.firstName }} on {{ commentaire.createdAt|date('Y-m-d H:i') }}</small>
            {% if app.user and app.user == commentaire.user %}
              <form method="post" action="{{ path('comment_delete', {'id': commentaire.id}) }}" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
                <button class="btn btn-sm btn-danger">🗑 Delete</button>
              </form>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if app.user %}
        <form action="{{ path('produit_comment', {'id': produit.id}) }}" method="POST" class="mt-3">
          <textarea name="content" class="form-control" placeholder="Add a comment..." maxlength="200" required></textarea>
          <input type="hidden" name="_token" value="{{ csrf_token('comment' ~ produit.id) }}">
          <button type="submit" class="btn btn-outline-success btn-sm mt-2">Submit</button>
        </form>
      {% endif %}
    </div>

    <div class="row related-products">
      <h3 class="fw-bold">Related Products</h3>
      {% for relatedProduct in relatedProducts %}
        <div class="col-md-3 mb-4">
          <div class="card related-product-card">
            <img src="{{ asset('uploads/images/' ~ relatedProduct.image) }}" class="card-img-top" alt="{{ relatedProduct.name }}">
            <div class="card-body">
              <h5 class="card-title">{{ relatedProduct.name }}</h5>
              <p class="card-text">{{ relatedProduct.price }} Dt</p>
              <a href="{{ path('produit_detailP', {'id': relatedProduct.id}) }}" class="btn btn-outline-primary">View Details</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}
