{% extends 'baseBackOffice.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
<main id="main" class="main">
  <div class="pagetitle">
    <h1>Détails du produit</h1>
    <nav>
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
        <li class="breadcrumb-item">Produits</li>
        <li class="breadcrumb-item active">Détails</li>
      </ol>
    </nav>
  </div>
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-body">
          <h1 class="mb-4 text-center">Détails du produit</h1>
          <table class="table table-bordered shadow-sm">
            <tbody>
              <tr>
                <th class="fw-bold bg-light">Nom</th>
                <td>{{ produit.name }}</td>
              </tr>
              <tr>
                <th class="fw-bold bg-light">Description</th>
                <td>{{ produit.desciption }}</td>
              </tr>
              <tr>
                <th class="fw-bold bg-light">Prix</th>
                <td><span class="badge bg-success fs-5">{{ produit.price }} DT</span></td>
              </tr>
              <tr>
                <th class="fw-bold bg-light">Image</th>
                <td>
                  {% if produit.image %}
                    <img src="{{ asset('uploads/images/' ~ produit.image) }}" alt="Product Image" class="img-thumbnail" style="max-width: 200px;">
                  {% else %}
                    <span class="text-muted">Aucune image</span>
                  {% endif %}
                </td>
              </tr>
              <tr>
                <th class="fw-bold bg-light">Quantité</th>
                <td>{{ produit.quantity }}</td>
              </tr>
            </tbody>
          </table>
          <div class="mt-4 d-flex justify-content-between">
            <a href="{{ path('app_produit_index') }}" class="btn btn-secondary me-2">
              <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn btn-warning me-2">
              <i class="fas fa-edit"></i> Modifier
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}
