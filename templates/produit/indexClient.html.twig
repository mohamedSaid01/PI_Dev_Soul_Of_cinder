{% extends 'baseFrontOffice.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
  <section id="products" class="py-5">
    <div class="content-container">
      <h2 class="page-title">Nos Produits</h2>
      
      <div class="search-container mb-4">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search products by name, category, or description..." 
          class="form-control"
        >
        <div id="search-results" style="display: none;"></div>
      </div>
     
      <!-- Filter by Category -->
     <div class="d-flex justify-content-between align-items-center mb-4">
        <form method="get" action="{{ path('front_list') }}" class="d-flex flex-wrap flex-grow-1 me-2">
          <select name="category" class="form-select me-2 mb-2 mb-md-0" style="max-width: 150px;">
            <option value="">All Categories</option>
            {% for category in categories %}
              <option value="{{ category.id }}" {{ selectedCategory == category.id ? 'selected' : '' }}>
                {{ category.name }}
              </option>
            {% endfor %}
          </select>
          <input type="number" name="minPrice" class="form-control me-2 mb-2 mb-md-0" style="max-width: 120px;" placeholder="Min Price" value="{{ minPrice }}">
          <input type="number" name="maxPrice" class="form-control me-2 mb-2 mb-md-0" style="max-width: 120px;" placeholder="Max Price" value="{{ maxPrice }}">
          <button type="submit" class="btn btn-secondary btn-sm mb-2 mb-md-0">Filter</button>
          {% if selectedCategory or minPrice or maxPrice %}
            <a href="{{ path('front_list') }}" class="btn btn-outline-secondary btn-sm ms-2 mb-2 mb-md-0">Reset</a>
          {% endif %}
        </form>
      </div>
    
      <!-- Product List -->
      <div class="row" id="product-list">
        {% for produit in produits %}
          <div class="col-md-4 mb-4">
            <div class="card card-fixed-size">
              <!-- Product Image -->
              <a href="{{ path('produit_detailP', {'id': produit.id}) }}">
                <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="card-img-fixed-height" alt="{{ produit.name }}">
              </a>
              
              <div class="card-body card-body-fixed-height">
                <!-- Product Title -->
                <a href="{{ path('produit_detailP', {'id': produit.id}) }}" class="text-decoration-none">
                  <h5 class="card-title">{{ produit.name }}</h5>
                </a>
                
                <!-- Price and Stock -->
                <p class="card-text-truncate">{{ produit.desciption|slice(0, 80) }}...</p>
                <p class="card-text"><strong>Price:</strong> {{ produit.price }} Dt</p>
                {% if produit.quantity < 3 %}
                  <p class="card-text text-danger"><small><strong>Alert: Only {{ produit.quantity }} left in stock!</strong></small></p>
                {% endif %}
              </div>
              
              <div class="card-footer bg-white border-top-0">
                <div class="d-flex flex-column gap-2">
                  <!-- Add to Cart Button -->
                  {% if app.user %}
                    <form action="{{ path('add_to_cart', {'id': produit.id}) }}" method="POST">
                      <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart' ~ produit.id) }}">
                      <button type="submit" class="btn btn-primary btn-sm w-100">Add To Cart</button>
                    </form>
                  {% endif %}
    
                  <!-- Toggle Favorite Button -->
                  {% if app.user %}
                    <form action="{{ path('toggle_favorite', {'id': produit.id}) }}" method="POST">
                      <input type="hidden" name="_token" value="{{ csrf_token('toggle_favorite' ~ produit.id) }}">
                      <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        {% if produit in app.user.favoris|map(f => f.produit) %}
                          ❤️ Remove from Favorites
                        {% else %}
                          🤍 Add to Favorites
                        {% endif %}
                      </button>
                    </form>
                  {% endif %}
                
                  <!-- View Details Button -->
                  <a href="{{ path('produit_detailP', {'id': produit.id}) }}" class="btn btn-outline-secondary btn-sm w-100">View Details</a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Comments Modal -->
  <div class="modal fade" id="commentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="commentsModalLabel">Product Comments</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="commentsModalBody">
          <!-- Comments will be loaded here -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');

      searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        
        if (query.length >= 2) {
          fetch(`/produit/search?q=${encodeURIComponent(query)}`)
            .then(response => response.json())
            .then(data => {
              searchResults.innerHTML = '';
              searchResults.style.display = 'block';
              
              if (data.products.length > 0) {
                data.products.forEach(product => {
                  const div = document.createElement('div');
                  div.classList.add('result-item');
                  div.innerHTML = `
                    <a href="/produit/${product.id}/detail" class="d-block p-2 text-decoration-none">
                      <strong>${product.name}</strong> - ${product.price} Dt
                    </a>
                  `;
                  searchResults.appendChild(div);
                });
              } else {
                searchResults.innerHTML = '<div class="p-2">No products found</div>';
              }
            });
        } else {
          searchResults.style.display = 'none';
        }
      });

      // Close search results when clicking outside
      document.addEventListener('click', function(e) {
        if (e.target !== searchInput && e.target !== searchResults) {
          searchResults.style.display = 'none';
        }
      });
    });
  </script>
{% endblock %}